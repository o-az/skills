{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.local/evals/benchmark-schema.json",
  "title": "Skill Eval Benchmark",
  "type": "object",
  "required": [
    "schema_version",
    "skill_name",
    "iteration",
    "generated_at",
    "workspace_root",
    "eval_ids",
    "runs_per_eval",
    "configs",
    "totals",
    "overall",
    "evals"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "skill_name": {
      "type": "string"
    },
    "iteration": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "workspace_root": {
      "type": "string"
    },
    "eval_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "runs_per_eval": {
      "type": "integer",
      "minimum": 1
    },
    "configs": {
      "type": "array",
      "prefixItems": [
        {
          "const": "with_skill"
        },
        {
          "const": "without_skill"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "totals": {
      "$ref": "#/$defs/totals"
    },
    "overall": {
      "$ref": "#/$defs/configSummaryWithDelta"
    },
    "evals": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/evalSummary"
      }
    }
  },
  "$defs": {
    "scalarSummary": {
      "type": "object",
      "required": ["mean", "stddev", "count"],
      "properties": {
        "mean": {
          "type": ["number", "null"]
        },
        "stddev": {
          "type": ["number", "null"]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metricSummary": {
      "type": "object",
      "required": ["pass_rate", "time_seconds", "tokens"],
      "properties": {
        "pass_rate": {
          "$ref": "#/$defs/scalarSummary"
        },
        "time_seconds": {
          "$ref": "#/$defs/scalarSummary"
        },
        "tokens": {
          "$ref": "#/$defs/scalarSummary"
        }
      }
    },
    "configSummary": {
      "type": "object",
      "required": ["metrics", "environment_failures", "grading_failures", "missing_runs"],
      "properties": {
        "metrics": {
          "$ref": "#/$defs/metricSummary"
        },
        "environment_failures": {
          "type": "integer",
          "minimum": 0
        },
        "grading_failures": {
          "type": "integer",
          "minimum": 0
        },
        "missing_runs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "configSummaryWithDelta": {
      "type": "object",
      "required": ["with_skill", "without_skill", "delta"],
      "properties": {
        "with_skill": {
          "$ref": "#/$defs/configSummary"
        },
        "without_skill": {
          "$ref": "#/$defs/configSummary"
        },
        "delta": {
          "type": "object",
          "required": ["pass_rate", "time_seconds", "tokens"],
          "properties": {
            "pass_rate": {
              "type": ["number", "null"]
            },
            "time_seconds": {
              "type": ["number", "null"]
            },
            "tokens": {
              "type": ["number", "null"]
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "expected_runs",
        "observed_runs",
        "environment_failures",
        "grading_failures",
        "missing_runs"
      ],
      "properties": {
        "expected_runs": {
          "type": "integer",
          "minimum": 0
        },
        "observed_runs": {
          "type": "integer",
          "minimum": 0
        },
        "environment_failures": {
          "type": "integer",
          "minimum": 0
        },
        "grading_failures": {
          "type": "integer",
          "minimum": 0
        },
        "missing_runs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evalSummary": {
      "type": "object",
      "required": ["with_skill", "without_skill", "delta"],
      "properties": {
        "with_skill": {
          "$ref": "#/$defs/configSummary"
        },
        "without_skill": {
          "$ref": "#/$defs/configSummary"
        },
        "delta": {
          "type": "object",
          "required": ["pass_rate", "time_seconds", "tokens"],
          "properties": {
            "pass_rate": {
              "type": ["number", "null"]
            },
            "time_seconds": {
              "type": ["number", "null"]
            },
            "tokens": {
              "type": ["number", "null"]
            }
          }
        }
      }
    }
  }
}
