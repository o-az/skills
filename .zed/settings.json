{
  "file_types": {
    "ini": ["**/.npmrc"],
    "env": [".env", ".env.*"],
    "JSONC": ["**/.zed/**/*.json"]
  },
  "hidden_files": ["**/.ruff_cache", "**/__pycache__/**"],
  "file_scan_exclusions": [".git", "**/.vscode", "**/.ruff_cache"],
  "use_autoclose": true,
  "enable_language_server": true,
  "formatter": "language_server",
  "prettier": {
    "allowed": false
  },
  "use_auto_surround": true,
  "language_servers": [
    "pkl",
    "!eslint",
    "!biome",
    "!typescript-language-server",
    "tombi",
    "oxfmt",
    "oxlint",
    "ruff",
    "pyrefly",
    "typescript-ls",
    "markdown-oxide",
    "json-language-server"
  ],
  "lsp": {
    "ruff": {
      "fetch": { "pre_release": true },
      "binary": {
        "path": "./.venv/bin/ruff",
        "arguments": ["server"]
      },
      "initialization_options": {
        "settings": {
          "configuration": "./pyproject.toml",
          "lint": {
            "extendSelect": ["I"]
          }
        }
      }
    },
    "pyrefly": {
      "fetch": {
        "pre_release": true
      },
      "binary": {
        "path": "./.venv/bin/pyrefly",
        "arguments": ["lsp"]
      }
    },
    "pkl": {
      "fetch": {
        "pre_release": true
      },
      "binary": {
        "ignore_system_version": false
      }
    },
    "tombi": {
      "fetch": {
        "pre_release": true
      },
      "binary": {
        "arguments": ["lsp", "-v"],
        "env": {
          "NO_COLOR": "true"
        },
        "ignore_system_version": false
      }
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "typeAware": true,
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "run": "onSave"
        }
      }
    }
  },
  "languages": {
    "Python": {
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports.ruff": true
      },
      "format_on_save": "on",
      "language_servers": ["ruff", "pyrefly", "!pyright", "!pylsp"],
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      }
    },
    "Shell Script": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}", "--indent", "2"]
        }
      }
    },
    "Pkl": {
      "language_servers": ["pkl"]
    },
    "TOML": {
      "format_on_save": "on",
      "language_servers": ["tombi"],
      "show_edit_predictions": false,
      "formatter": {
        "language_server": {
          "name": "tombi"
        }
      }
    },
    "Markdown": {
      "language_servers": [
        "typescript-ls",
        "!typescript-language-server",
        "oxfmt",
        "oxlint",
        "markdown-oxide"
      ],
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSON": {
      "format_on_save": "on",
      "language_servers": ["json-language-server", "oxfmt", "oxlint"],
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSONC": {
      "format_on_save": "on",
      "language_servers": ["json-language-server", "oxfmt", "oxlint"],
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSDoc": {
      "language_servers": ["typescript-ls", "!typescript-language-server", "oxfmt", "oxlint"],
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TSX": {
      "format_on_save": "on",
      "language_servers": ["typescript-ls", "!typescript-language-server", "oxfmt", "oxlint"],
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JavaScript": {
      "format_on_save": "on",
      "language_servers": ["typescript-ls", "!typescript-language-server", "oxfmt", "oxlint"],
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TypeScript": {
      "format_on_save": "on",
      "language_servers": ["typescript-ls", "!typescript-language-server", "oxfmt", "oxlint"],
      "prettier": {
        "allowed": false
      },
      "inlay_hints": { "enabled": false },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "YAML": {
      "format_on_save": "on",
      "language_servers": ["oxfmt", "oxlint"],
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    }
  }
}
