{
  "name": "skills",
  "type": "module",
  "scripts": {
    "format": "oxfmt --write",
    "lint": "oxlint --fix",
    "check": "bun run --parallel --stream --reporter='append-only' format lint",
    "postinstall": "simple-git-hooks"
  },
  "devDependencies": {
    "@j178/prek": "^0.3.6",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "bun prek run --all-files --config='.github/.pre-commit.yml' && bun check"
  }
}
